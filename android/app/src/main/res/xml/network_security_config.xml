<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Restrict cleartext traffic. In production pin certificates or use a custom TrustManager.
  Do not weaken this for convenience.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext only for local development if needed -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android emulator localhost -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
